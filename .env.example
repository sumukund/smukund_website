# Google Calendar Appointment Schedule embed URL
# Create an Appointment Schedule in Google Calendar → Share → Website embed
PUBLIC_GOOGLE_CALENDAR_EMBED_URL=https://calendar.google.com/calendar/appointments/schedules/YOUR_SCHEDULE_ID?gv=true

# Optional: direct booking page URL (opens in a new tab)
PUBLIC_GOOGLE_CALENDAR_BOOKING_URL=https://calendar.google.com/calendar/appointments/YOUR_SCHEDULE_ID
